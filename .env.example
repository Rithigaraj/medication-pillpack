# Copy this file to .env and fill in your credentials.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords

MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_DEFAULT_SENDER=you@gmail.com

# Optional overrides
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# SECRET_KEY=change-me-in-production
# OTP_TTL_SECONDS=600
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_HOUR=3

# Firebase Cloud Messaging (push alerts to caregivers on missed doses).
# 1. Create a Firebase project, enable Cloud Messaging.
# 2. Project settings -> Service accounts -> Generate new private key; save the JSON,
#    then point FIREBASE_CREDENTIALS at it (or copy it to instance/firebase-service-account.json).
# 3. Project settings -> General -> Your apps -> Web app: copy the config values below.
# 4. Cloud Messaging -> Web configuration -> generate a Web Push certificate (VAPID key).
# Without these, the app runs normally; the caregiver "Enable missed-dose alerts" button stays hidden.
# FIREBASE_PROJECT_ID=my-project-id
# FIREBASE_CREDENTIALS=instance/firebase-service-account.json
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=my-project-id.firebaseapp.com
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_VAPID_KEY=
# ALERTS_POLL_SECONDS=45
